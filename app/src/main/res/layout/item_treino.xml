<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dark"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Topo do Card: Data/Dia e Botões de Ação (Editar e Excluir) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvItemData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Segunda-feira"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnItemEditar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar treino"
                android:padding="7dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_gray" />

            <ImageButton
                android:id="@+id/btnItemExcluir"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir treino"
                android:padding="7dp"
                android:src="@drawable/ic_delete"
                app:tint="#FF5C5C" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Nome do Treino -->
    <TextView
        android:id="@+id/tvItemNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Nome do Treino"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Local ou Foco -->
    <TextView
        android:id="@+id/tvItemLocal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Local / Grupo Muscular"
        android:textColor="@color/text_gray"
        android:textSize="13sp" />

    <!-- Descrição / Séries -->
    <TextView
        android:id="@+id/tvItemDescricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Descrição dos exercícios..."
        android:textColor="@color/text_white"
        android:textSize="13sp" />

    <!-- Dica discreta de toque para edição -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="✎ Toque para editar este treino"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
