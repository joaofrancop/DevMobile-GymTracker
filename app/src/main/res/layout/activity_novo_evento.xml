<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBackForm"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Voltar"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_white" />

            <TextView
                android:id="@+id/tvTituloFormulario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Novo Treino"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Campo: Nome do Treino / Evento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Treino / Evento"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNomeEvento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:hint="ex: Full Body Blast A"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <!-- Campo: Dia da Semana / Data -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Dia da Semana / Data"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDataEvento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:hint="ex: Segunda-feira, 19:00"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <!-- Campo: Local / Grupo Muscular -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Local / Grupo Muscular"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocalEvento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:hint="ex: Peito, Tríceps (Academia Central)"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <!-- Campo: Descrição / Exercícios -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Descrição dos Exercícios e Séries"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescricaoEvento"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="top|start"
            android:hint="Liste exercícios, repetições, cargas e notas:\n(ex: Supino reto: 4 séries de 8-10 reps)..."
            android:padding="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Botão Salvar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarEvento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_lime"
            android:text="SALVAR TREINO"
            android:textColor="#0E1116"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:elevation="4dp" />

    </LinearLayout>
</ScrollView>
